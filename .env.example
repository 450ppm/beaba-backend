# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
RESEND_API_KEY=
RESEND_FROM=Beaba <noreply@450ppm.be>

# ── Architecture split (API + CDN frontend) ──────────
# Si le frontend est sur un autre domaine, configurer :
# API_PUBLIC_URL=https://api.beaba.450ppm.be/api
# FRONTEND_URL=https://beaba.450ppm.be
# COOKIE_DOMAIN=.450ppm.be
# CORS_ORIGINS=https://beaba.450ppm.be

# ── Kit ───────────────────────────────────────────────
KIT_ID=beaba_001
KIT_NAME=Kit Beaba

# ── SQLite ────────────────────────────────────────────
SQLITE_PATH=./data/beaba.db

# ── API ───────────────────────────────────────────────
API_PORT=3000

# ── MQTT (zigbee2mqtt) ────────────────────────────────
MQTT_BROKER=mqtt://localhost:1883

# ── Shelly EM (mesure de puissance) ──────────────────
# SHELLY_EM_IP=192.168.1.xx
SHELLY_POLL_INTERVAL_S=30

# ── Shelly Plus + Add-On (sondes DS18B20 sur tuyaux) ─
# Intervalle de polling des temperatures pipe en secondes
SHELLY_PIPE_POLL_S=20

# ── Email (Resend) ───────────────────────────────────
# Logo affiche dans les emails (par defaut: FRONTEND_URL/beaba_banner.png)
# EMAIL_LOGO_URL=https://beaba.450ppm.be/beaba_banner.png

# ── InfluxDB cloud ────────────────────────────────────
INFLUX_URL=https://eu-central-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=
INFLUX_ORG=450ppm
INFLUX_BUCKET=beaba
SYNC_INTERVAL_MIN=5

# ── Tarif electricite (EUR/kWh) ──────────────────────
ELECTRICITY_RATE=0.2516
